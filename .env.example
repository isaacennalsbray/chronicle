# Neon Postgres — provided automatically by the Vercel Neon integration.
# Locally: `vercel env pull .env.local`
DATABASE_URL=

# Vercel Blob — provided automatically when a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# Signs session cookies and hashes login PINs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Comma-separated list of admin emails.
ADMIN_EMAILS=

# Resend (https://resend.com). Without a key in development, emails are printed to the console.
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
EMAIL_FROM="Falnorian Chronicles <chronicles@isaaceb.org>"

# Public base URL, used for links in emails.
APP_URL=http://localhost:3000
